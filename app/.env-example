# Update environment variables
# Rename this file to .env


# Server
HOST=localhost
PORT=5000


# Versions
CODE_VERSION=1.1.0
MODELS_VERSION=0.0.1


# ElasticSearch
DOCKER_ES_SCHEME=http
DOCKER_ES_HOST=localhost
DOCKER_ES_PORT=9200
ES_EMBEDDING_INDEX=
ES_EMBEDDING_INDEX_LENGTH=1000
PATH_TO_ES_INITIAL_VALUES=../../Webiks_Hebrew_RAGbot_KolZchut_Paragraphs_Corpus_v1.0.json


# Indexes
CONVERSATION_INDEX=conversation
CONFIG_INDEX=saved_configurations
CONFIG_CACHE_PERIOD_SECS=3


# Paths
STATIC_DIR=../../app/src/static
MODEL_LOCATION=../../app/artifacts
DOCUMENT_DEFINITION_CONFIG=./doc-config.json


# LLM
OAI_API_KEY=
IS_MOCK_GPT_CLIENT=FALSE


# Optional second retrieval stage: an LLM reorders the candidate pages by their titles.
# OFF by default. To turn it on set TITLE_RERANK_ENABLED=true and pick a provider and model.
# Providers: openai (also any OpenAI-compatible server via TITLE_RERANK_BASE_URL: Azure, Ollama, vLLM, ...),
# anthropic (pip install anthropic), gemini, or any name registered with llm_factory.register_provider.
# Empty TITLE_RERANK_API_KEY uses the provider's usual variable (OAI_API_KEY/OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GOOGLE_API_KEY). On any LLM failure the plain retrieval order is used.
TITLE_RERANK_ENABLED=false
TITLE_RERANK_PROVIDER=openai
TITLE_RERANK_MODEL=gpt-4o-mini
TITLE_RERANK_API_KEY=
TITLE_RERANK_BASE_URL=
TITLE_RERANK_CANDIDATES=30
TITLE_RERANK_POOL_PARAGRAPHS=200
TITLE_RERANK_TIMEOUT_SECS=5
